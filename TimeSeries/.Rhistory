geom_text(data = label(tree_labels), aes(x=x, y=y, label=label, colour = Diagnosis, hjust=0), size=3) +
coord_flip()
library(dendextend)
library(ggdendro)
library(ggplot2)
# Create a dendrogram
hc <- hclust(dist(USArrests), "ave")
dend <- as.dendrogram(hc)
# Color branches by clusters
dend_colored <- dend %>% branches_attr_by_clusters(k = 3)
# Create a dendrogram
hc <- hclust(dist(USArrests), "ave")
dend <- as.dendrogram(hc)
# Determine clusters
clusters <- cutree(hc, k = 3)
# Color branches by clusters
dend_colored <- dend %>% branches_attr_by_clusters(clusters = clusters)
# Convert to data suitable for ggplot
dend_data <- dendro_data(dend_colored)
# Get the colors for each segment
segment_colors <- get_leaves_attr(dend_colored, "edgePar", "col")
# Get the colors for each segment
segment_colors <- get_branches_attr(dend_colored, "col")
library(dendextend)
library(ggdendro)
library(ggplot2)
# Get the colors for each segment
segment_colors <- get_branches_attr(dend_colored, "col")
# Create a dendrogram
hc <- hclust(dist(USArrests), "ave")
dend <- as.dendrogram(hc)
# Determine clusters
clusters <- cutree(hc, k = 3)
# Color branches by clusters
dend_colored <- dend %>% branches_attr_by_clusters(clusters = clusters)
# Convert to data suitable for ggplot
dend_data <- dendro_data(dend_colored)
# Extract segment colors
segment_colors <- unlist(get_leaves_branches_col(dend_colored))
# Ensure the colors are applied to the segments data frame
dend_data$segments$col <- segment_colors
# Create a dendrogram
hc <- hclust(dist(USArrests), "ave")
dend <- as.dendrogram(hc)
# Determine clusters
clusters <- cutree(hc, k = 3)
# Color branches by clusters
dend_colored <- dend %>% branches_attr_by_clusters(clusters = clusters)
# Convert to data suitable for ggplot
dend_data <- dendro_data(dend_colored)
# Extract the colors for the branches
segment_colors <- get_branches_attr(dend_colored, "col", simplify = FALSE)
# Create a dendrogram
hc <- hclust(dist(USArrests), "ave")
dend <- as.dendrogram(hc)
# Determine clusters
clusters <- cutree(hc, k = 3)
# Color branches by clusters
dend_colored <- dend %>% branches_attr_by_clusters(clusters = clusters)
# Convert to data suitable for ggplot
dend_data <- dendro_data(dend_colored)
# Extract segment colors directly from dend_data
segment_colors <- dend_data$segments$col
# Ensure the colors are applied to the segments data frame
if (is.null(segment_colors)) {
segment_colors <- rep("black", nrow(dend_data$segments))  # Default color if not set
}
dend_data$segments$col <- segment_colors
# Plot using ggplot
ggplot() +
geom_segment(data = dend_data$segments,
aes(x = x, y = y, xend = xend, yend = yend, color = col)) +
geom_text(data = dend_data$labels,
aes(x = x, y = y, label = label), hjust = 1) +
scale_color_identity() +
theme_minimal() +
labs(x = "Height", y = "Label")
nrow(dend_data$segments)
segment_colors
segment_colors
View(dend_data)
View(hc)
View(dend_data)
quit()
