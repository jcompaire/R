# Load ggplot2 library
library(ggplot2)
# Create a sample data frame
df <- data.frame(
x = rnorm(100),
y = rnorm(100),
z = rnorm(100)
)
# Create a ggplot scatter plot with color scale
p <- ggplot(df, aes(x = x, y = y, color = z)) +
geom_point() +
scale_color_gradientn(colours = c("blue", "green", "yellow", "red"))
p
p + guides(color = guide_colorbar(
frame.colour = "black",    # Color of the border
frame.linewidth = 1.5,     # Width of the border line
ticks.colour = "black",    # Color of the ticks
ticks.linewidth = 1.5      # Width of the tick lines
))
p + guides(color = guide_colorbar(
frame.colour = "black",    # Color of the border
frame.linewidth = 0.5,     # Width of the border line
# ticks.colour = "black",    # Color of the ticks
# ticks.linewidth = 1.5      # Width of the tick lines
))
p + guides(color = guide_colorbar(
frame.colour = "black",    # Color of the border
frame.linewidth = 0.5,     # Width of the border line
ticks.colour = "black",    # Color of the ticks
ticks.linewidth = 0.5      # Width of the tick lines
))
p + guides(color = guide_colorbar(
frame.colour = "black",    # Color of the border
frame.linewidth = 0.5,     # Width of the border line
ticks.colour = "black",    # Color of the ticks
ticks.linewidth = 0.25      # Width of the tick lines
))
